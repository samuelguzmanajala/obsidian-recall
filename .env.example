# Load with: node --env-file=.env dist/server/main.cjs
# Generate locally: openssl rand -hex 32
RECALL_TOKEN=
RECALL_HOST=127.0.0.1
RECALL_PORT=27124
RECALL_DB=./data/recall.sqlite
TZ=Europe/Madrid
# Empty tags = all cards. Comma-separated, without #.
RECALL_TAGS=
RECALL_DAILY_NEW=20
RECALL_DAILY_REVIEW=0
# Optional cloud audio. Leave empty to use Android's on-device TTS.
RECALL_TTS_KEY=
RECALL_TTS_VOICE=alloy
RECALL_TTS_MODEL=gpt-4o-mini-tts
RECALL_AUDIO_DIR=./data/audio
RECALL_LLM_PROVIDER=none
RECALL_LLM_KEY=
RECALL_LLM_MODEL=
